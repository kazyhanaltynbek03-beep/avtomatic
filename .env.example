# Copy to .env. Change all passwords before a real deployment.
POSTGRES_DB=qor
POSTGRES_USER=qor
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_ENV=production
OWNER_EMAIL=owner@qor.local
OWNER_PASSWORD=replace-with-a-strong-owner-password
# Required in production: 32-byte urlsafe Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# For localhost HTTP only. Set true behind HTTPS in production.
COOKIE_SECURE=false
DEMO_MODE=false
# Claude text AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: after all 11 QOR Skills are uploaded to the same Anthropic API
# workspace, pin each returned Skill ID and version here as a JSON object.
# Keep real IDs and API keys in Render secrets; never commit them.
# QOR_CLAUDE_SKILLS_JSON={"qor-arman-ceo":{"skill_id":"skill_...","version":"skver_..."}}
# Optional: OpenAI Images API is used only by AI Designer image editing
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional outbound WhatsApp Business Cloud API. Send only to an opted-in recipient.
# The WABA must have an approved utility template named below with one body placeholder.
QOR_WHATSAPP_ACCESS_TOKEN=
QOR_WHATSAPP_PHONE_NUMBER_ID=
QOR_WHATSAPP_TEMPLATE_NAME=qor_daily_business_report
QOR_WHATSAPP_TEMPLATE_LANGUAGE=ru
QOR_WHATSAPP_GRAPH_VERSION=v26.0
# Shared secret for the separate Render Cron service that invokes the due check.
QOR_DAILY_REPORT_TRIGGER_URL=https://qor-ai-business-erp.onrender.com/api/internal/daily-report/run
QOR_DAILY_REPORT_TRIGGER_TOKEN=
# Marketplace credentials are stored per integration through the QOR interface.
# Do not set marketplace account tokens as Render environment variables.
