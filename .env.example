# Copy to .env. Change all passwords before a real deployment.
POSTGRES_DB=qor
POSTGRES_USER=qor
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_ENV=production
OWNER_EMAIL=owner@qor.local
OWNER_PASSWORD=replace-with-a-strong-owner-password
# Required in production: 32-byte urlsafe Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# For localhost HTTP only. Set true behind HTTPS in production.
COOKIE_SECURE=false
DEMO_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# Marketplace credentials are stored per integration through the QOR interface.
# Do not set marketplace account tokens as Render environment variables.
